{
  "groups": [
    {
      "name": "llama4j",
      "type": "com.llama4j.spring.LlamaProperties",
      "sourceType": "com.llama4j.spring.LlamaProperties",
      "description": "llama4j 配置属性"
    },
    {
      "name": "llama4j.api",
      "type": "com.llama4j.spring.LlamaProperties$ApiConfig",
      "sourceType": "com.llama4j.spring.LlamaProperties$ApiConfig",
      "sourceMethod": "getApi()",
      "description": "API 安全配置"
    },
    {
      "name": "llama4j.models",
      "type": "java.util.List<com.llama4j.spring.LlamaProperties$ModelConfig>",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig",
      "description": "多模型配置列表"
    },
    {
      "name": "llama4j.inference",
      "type": "com.llama4j.spring.LlamaProperties$InferenceConfig",
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig",
      "sourceMethod": "getInference()",
      "description": "推理默认参数"
    }
  ],
  "properties": [
    {
      "name": "llama4j.api.key",
      "type": "java.lang.String",
      "description": "API Key，用于保护 /v1/** 和 /api/** 端点",
      "sourceType": "com.llama4j.spring.LlamaProperties$ApiConfig"
    },
    {
      "name": "llama4j.default-model",
      "type": "java.lang.String",
      "description": "默认使用的模型名称",
      "sourceType": "com.llama4j.spring.LlamaProperties"
    },
    {
      "name": "llama4j.models[].name",
      "type": "java.lang.String",
      "description": "模型名称（唯一标识）",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].type",
      "type": "java.lang.String",
      "description": "模型类型：local（本地 GGUF）或 openai（OpenAI 兼容 API）",
      "defaultValue": "local",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].path",
      "type": "java.lang.String",
      "description": "本地 GGUF 模型文件路径",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].mmproj-path",
      "type": "java.lang.String",
      "description": "多模态投影器（mmproj）路径，用于 VLM 模型",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].model-id",
      "type": "java.lang.String",
      "description": "HuggingFace 模型 ID，自动下载",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].n-ctx",
      "type": "java.lang.Integer",
      "description": "上下文窗口大小",
      "defaultValue": 4096,
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].n-gpu-layers",
      "type": "java.lang.Integer",
      "description": "卸载到 GPU 的层数，-1 表示全部卸载",
      "defaultValue": -1,
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].n-threads",
      "type": "java.lang.Integer",
      "description": "CPU 推理线程数",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].api-key",
      "type": "java.lang.String",
      "description": "OpenAI 兼容 API 的密钥",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].base-url",
      "type": "java.lang.String",
      "description": "OpenAI 兼容 API 的基础 URL",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.models[].model-name",
      "type": "java.lang.String",
      "description": "云端 API 使用的模型名称",
      "sourceType": "com.llama4j.spring.LlamaProperties$ModelConfig"
    },
    {
      "name": "llama4j.inference.temperature",
      "type": "java.lang.Float",
      "description": "采样温度（0 = 贪心解码，越高越随机）",
      "defaultValue": 0.7,
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig"
    },
    {
      "name": "llama4j.inference.max-tokens",
      "type": "java.lang.Integer",
      "description": "最大生成 token 数",
      "defaultValue": 2048,
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig"
    },
    {
      "name": "llama4j.inference.top-k",
      "type": "java.lang.Integer",
      "description": "Top-K 采样参数",
      "defaultValue": 40,
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig"
    },
    {
      "name": "llama4j.inference.top-p",
      "type": "java.lang.Float",
      "description": "Top-P 核采样阈值",
      "defaultValue": 0.9,
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig"
    },
    {
      "name": "llama4j.inference.repeat-penalty",
      "type": "java.lang.Float",
      "description": "重复惩罚系数（>1.0 抑制重复）",
      "defaultValue": 1.1,
      "sourceType": "com.llama4j.spring.LlamaProperties$InferenceConfig"
    }
  ]
}
